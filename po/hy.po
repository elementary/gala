msgstr "Պետք է տեղադրված լինի «settings://» URI սխեմայի մշակիչ։"

#: data/gala-multitaskingview.desktop.in:3
#: data/gala-multitaskingview.desktop.in:5
msgid "Multitasking View"
msgstr "Բազմախնդիր դիտում"

#: data/gala-multitaskingview.desktop.in:4
msgid "View all open windows and workspaces"
msgstr "Դիտել բոլոր բաց պատուհանները և աշխատանքային տարածքները"

#: data/gala-other.desktop.in:3
msgid "Other"
msgstr "Այլ"

#: data/gala-other.desktop.in:4
msgid "Fallback desktop file for notifications from outdated applications."
msgstr "Պահուստային աշխատասեղանի ֆայլ հնացած հավելվածների ծանուցումների համար։"

#: data/gala.metainfo.xml.in:11
msgid "Multitasking & Window Management"
msgstr "Բազմախնդրություն և պատուհանների կառավարում"

#: data/gala.metainfo.xml.in:12
msgid "A window & compositing manager for Pantheon"
msgstr "Pantheon-ի պատուհանների և կոմպոզիտային կառավարիչ"

#: data/gala.metainfo.xml.in:14
msgid ""
"A window & compositing manager based on libmutter and designed by elementary "
"for use with Pantheon."
msgstr ""
"Պատուհանների և կոմպոզիտային կառավարիչ՝ հիմնված libmutter-ի վրա և elementary-"
"ի կողմից նախագծված Pantheon-ի հետ օգտագործելու համար։"

#: data/gala.metainfo.xml.in:24
msgid "elementary, Inc."
msgstr "elementary, Inc."

