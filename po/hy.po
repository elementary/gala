msgstr "Փոխել Ետնանկարը…"

#: daemon/DBus.vala:35 daemon-gtk3/BackgroundMenu.vala:16
msgid "Display Settings…"
msgstr "Էկրանի կարգավորումներ…"

#: daemon/DBus.vala:41 daemon-gtk3/BackgroundMenu.vala:22
msgid "System Settings…"
msgstr "Համակարգի կարգավորումներ…"

#: daemon/DBus.vala:152 daemon-gtk3/BackgroundMenu.vala:47
msgid "Failed to open System Settings"
msgstr "Չհաջողվեց բացել Համակարգի կարգավորումները"

#: daemon/DBus.vala:153 daemon-gtk3/BackgroundMenu.vala:48
