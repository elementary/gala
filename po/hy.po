msgstr "«%s»-ը չի արձագանքում"

#: src/Dialogs/CloseDialog.vala:27
msgid "Application is not responding"
msgstr "Հավելվածը չի արձագանքում"

#: src/Dialogs/CloseDialog.vala:30
msgid ""
"You may choose to wait a short while for the application to continue, or "
"force it to quit entirely."
msgstr ""
"Կարող եք մի փոքր սպասել, որ հավելվածը շարունակի աշխատել, կամ ստիպողաբար "
"փակել այն։"

#: src/Dialogs/CloseDialog.vala:31
msgid "Force Quit"
msgstr "Ստիպողաբար փակել"

#: src/Dialogs/CloseDialog.vala:32
msgid "Wait"
msgstr "Սպասել"

#: src/Dialogs/InhibitShortcutsDialog.vala:23
#, c-format
msgid "“%s” wants to inhibit system shortcuts"
msgstr "«%s»-ը ցանկանում է արգելափակել համակարգային դյուրանցումները"

#: src/Dialogs/InhibitShortcutsDialog.vala:25
msgid "An application wants to inhibit system shortcuts"
msgstr "Հավելվածը ցանկանում է արգելափակել համակարգային դյուրանցումները"

#: src/Dialogs/InhibitShortcutsDialog.vala:28
msgid "All system shortcuts will be redirected to the application."
msgstr "Բոլոր համակարգային դյուրանցումները կվերահասցեագրվեն հավելվածին։"

#: src/Dialogs/InhibitShortcutsDialog.vala:29
msgid "Allow"
msgstr "Թույլատրել"

#: src/Dialogs/InhibitShortcutsDialog.vala:30
msgid "Deny"
msgstr "Մերժել"

#: src/Misc/DesktopIntegration.vala:213
msgid "Window has already focus"
msgstr "Պատուհանն արդեն ֆոկուսում է"

