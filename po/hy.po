#: src/Misc/ScreenshotManager.vala:199 src/Misc/ScreenshotManager.vala:674
msgid "Screenshot taken"
msgstr "Էկրանի նկարն արված է"

#: src/Misc/ScreenshotManager.vala:200
msgid "Screenshot is saved to clipboard"
msgstr "Էկրանի նկարը պահպանվել է Սեղմատախտակում"

#: src/Misc/ScreenshotManager.vala:200
msgid "Screenshot saved to screenshots folder"
msgstr "Էկրանի նկարը պահպանվել է էկրանի նկարների պանակում"

#: src/Misc/ScreenshotManager.vala:589
msgid "Screenshots"
msgstr "Էկրանի նկարներ"

#: src/Misc/WindowMenuManager.vala:91
msgid "Take Screenshot"
msgstr "Անել էկրանի նկար"

#: src/Misc/WindowMenuManager.vala:97
msgid "Always on Top"
msgstr "Միշտ վերևում"

#: src/Misc/WindowMenuManager.vala:99
msgid "Show on all Workspaces"
msgstr "Ցուցադրել բոլոր աշխատանքային տարածքներում"

#: src/Misc/WindowMenuManager.vala:101
msgid "Move to Workspace Left"
msgstr "Տեղափոխել ձախ աշխատանքային տարածք"

#: src/Misc/WindowMenuManager.vala:103
msgid "Move to Workspace Right"
msgstr "Տեղափոխել աջ աշխատանքային տարածք"

#: src/Misc/WindowMenuManager.vala:115
msgid "Move"
