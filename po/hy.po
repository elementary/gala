#: data/gala.metainfo.xml.in:473 data/gala.metainfo.xml.in:489
msgid "Improvements:"
msgstr "Բարելավումներ՝"

#: data/gala.metainfo.xml.in:34
msgid "Fixed the force quit dialog showing after already closing the window"
msgstr ""
"Ուղղվել է ստիպողաբար փակելու երկխոսության ցուցադրումը պատուհանը արդեն "
"փակելուց հետո"

#: data/gala.metainfo.xml.in:35
msgid "Fixed a crash when dialogs appear on inactive workspaces"
msgstr ""
"Ուղղվել է խափանումը, երբ երկխոսություններ են հայտնվում ոչ ակտիվ աշխատանքային "
"տարածքներում"

#: data/gala.metainfo.xml.in:50
msgid "Fixed a frequent crash when using the classic session"
msgstr "Ուղղվել է հաճախակի խափանումը դասական աշխատաշրջանն օգտագործելիս"

#: data/gala.metainfo.xml.in:51 data/gala.metainfo.xml.in:68
#: data/gala.metainfo.xml.in:82 data/gala.metainfo.xml.in:94
#: data/gala.metainfo.xml.in:112 data/gala.metainfo.xml.in:126
#: data/gala.metainfo.xml.in:146 data/gala.metainfo.xml.in:170
#: data/gala.metainfo.xml.in:205 data/gala.metainfo.xml.in:217
#: data/gala.metainfo.xml.in:232 data/gala.metainfo.xml.in:258
#: data/gala.metainfo.xml.in:270 data/gala.metainfo.xml.in:284
#: data/gala.metainfo.xml.in:317 data/gala.metainfo.xml.in:348
#: data/gala.metainfo.xml.in:361 data/gala.metainfo.xml.in:376
#: data/gala.metainfo.xml.in:395 data/gala.metainfo.xml.in:411
#: data/gala.metainfo.xml.in:454 data/gala.metainfo.xml.in:476
#: data/gala.metainfo.xml.in:491
msgid "Updated translations"
msgstr "Թարմացված թարգմանություններ"

#: data/gala.metainfo.xml.in:63
msgid "Show transient windows over their parents in the multitasking view"
msgstr ""
"Բազմախնդիր դիտման մեջ ժամանակավոր պատուհանները ցուցադրվում են իրենց ծնող "
"պատուհանների վրա"

#: data/gala.metainfo.xml.in:64
msgid "Added a brand new on screen keyboard for the secure session"
msgstr ""
"Անվտանգ աշխատաշրջանի համար ավելացվել է բոլորովին նոր էկրանային ստեղնաշար"

#: data/gala.metainfo.xml.in:65
msgid "Screenshotting a window now includes open menus"
msgstr "Պատուհանի էկրանի նկարն այժմ ներառում է բաց մենյուները"

#: data/gala.metainfo.xml.in:66
msgid ""
"On touchscreens swiping up from the bottom will now open the multitasking "
"view"
msgstr "Հպէկրանների վրա ներքևից վերև սահեցնելն այժմ կբացի բազմախնդիր դիտումը"

#: data/gala.metainfo.xml.in:67
msgid ""
"Fixed various edge cases that could lead to glitches with minimize and "
"maximize animations"
msgstr ""
"Ուղղվել են տարբեր սահմանային դեպքեր, որոնք կարող էին թերություններ առաջացնել "
"ծալելու և ընդլայնելու անիմացիաներում"

#: data/gala.metainfo.xml.in:81
msgid "Fixed a frequent crash with multi monitor setups"
msgstr "Ուղղվել է հաճախակի խափանումը մի քանի մոնիտորով կարգավորումների դեպքում"

#: data/gala.metainfo.xml.in:127 data/gala.metainfo.xml.in:147
#: data/gala.metainfo.xml.in:171
msgid "Improved HiDPI support"
msgstr "Բարելավվել է HiDPI-ի աջակցությունը"

#: data/gala.metainfo.xml.in:148
msgid "Improve Reduced Motion behavior"
msgstr "Բարելավվել է «Նվազեցված շարժում» գործառույթի աշխատանքը"

#: data/gala.metainfo.xml.in:172
msgid "Improved render performance"
msgstr "Բարելավվել է պատկերման արագագործությունը"

#: data/gala.metainfo.xml.in:173
msgid "Reveal dock and panel in sync when starting"
msgstr "Dock-ը և վահանակը գործարկման ժամանակ ցուցադրվում են համաժամանակ"

#: data/gala.metainfo.xml.in:174
msgid "Improved workspace switch dock animation"
msgstr "Բարելավվել է աշխատանքային տարածքների փոխարկման Dock-ի անիմացիան"

#: data/gala.metainfo.xml.in:175
msgid "Picture-in-Picture windows now have rounded corners"
msgstr "«Պատկեր պատկերում» պատուհաններն այժմ ունեն կլորացված անկյուններ"

#: data/gala.metainfo.xml.in:285
msgid "Window state is now saved on sleep and shutdown"
msgstr "Պատուհանի վիճակն այժմ պահպանվում է քնի և անջատման ժամանակ"

#: data/gala.metainfo.xml.in:286
msgid "Remove scaling effect from menus"
msgstr "Ցանկերից հեռացվել է մասշտաբավորման էֆեկտը"

#: data/gala.metainfo.xml.in:287
msgid "Swipe up to close windows in Multitasking View"
msgstr "Սահեցրեք վերև՝ Բազմախնդիր դիտման մեջ պատուհանները փակելու համար"

#: data/gala.metainfo.xml.in:318
msgid "Fixed rare crash when a dock window was killed"
msgstr ""
"Ուղղվել է հազվադեպ խափանումը, երբ Dock-ի պատուհանը ստիպողաբար ավարտվում էր"

#: data/gala.metainfo.xml.in:319
msgid "Added interactive screenshot shortcut"
msgstr "Ավելացվել է էկրանի նկարի ինտերակտիվ դյուրանցում"

#: data/gala.metainfo.xml.in:320
msgid "Fixed crash when using tiling shortcuts"
msgstr "Ուղղվել է խափանումը սալիկավորման դյուրանցումներ օգտագործելիս"

#: data/gala.metainfo.xml.in:349
msgid "Improved shadows performance"
msgstr "Բարելավվել է ստվերների արագագործությունը"

#: data/gala.metainfo.xml.in:393
msgid "Fix a potential crash when moving windows between workspaces"
msgstr ""
"Ուղղվել է հնարավոր խափանումը պատուհանները աշխատանքային տարածքների միջև "
"տեղափոխելիս"

#: data/gala.metainfo.xml.in:394
msgid "Fix notification animation when entering multitasking view"
msgstr "Ուղղվել է ծանուցման անիմացիան բազմախնդիր դիտում մտնելիս"

#: data/gala.metainfo.xml.in:409
msgid "Improve keyboard navigation in Multitasking View"
msgstr "Բարելավվել է ստեղնաշարով նավիգացիան Բազմախնդիր դիտման մեջ"

#: data/gala.metainfo.xml.in:410
msgid "Change panel color at the same time as wallpaper transition"
msgstr "Վահանակի գույնը փոխվում է Ետնանկարի անցման հետ միաժամանակ"

#: data/gala.metainfo.xml.in:450
msgid ""
"Changing the wallpaper or going to sleep respects the \"Reduce Motion\" "
"option"
msgstr ""
"Ետնանկարը փոխելիս կամ քնի անցնելիս հաշվի է առնվում «Նվազեցնել շարժումը» "
"ընտրանքը"

#: data/gala.metainfo.xml.in:451
msgid "Use appropriate drag-and-drop pointers when moving windows"
msgstr ""
"Պատուհանները տեղափոխելիս օգտագործվում են համապատասխան «քաշել և թողնել» "
"ցուցիչներ"

#: data/gala.metainfo.xml.in:452
msgid "Fix the issue when gestures in the multitasking view might stop working"
msgstr ""
"Ուղղվել է խնդիրը, երբ բազմախնդիր դիտման ժեստերը կարող էին դադարել աշխատել"

#: data/gala.metainfo.xml.in:453
msgid "Improve dynamic workspaces behaviour with multiple monitors"
msgstr ""
"Բարելավվել է դինամիկ աշխատանքային տարածքների վարքը մի քանի մոնիտորների "
"դեպքում"

#: data/gala.metainfo.xml.in:475
msgid "Improve handling of move-to-workspace shortcut"
msgstr "Բարելավվել է աշխատանքային տարածք տեղափոխելու դյուրանցման մշակումը"

